{
  "newLinkFormat": "relative",
  "useMarkdownLinks": false,
  "showUnsupportedFiles": true,
  "attachmentFolderPath": "./attachments",
  "alwaysUpdateLinks": true,
  "promptDelete": false,
  "readableLineLength": false,
  "rightToLeft": false,
  "spellcheck": true,
  "spellcheckLanguages": null,
  "showLineNumber": false,
  "strictLineBreaks": false,
  "showIndentGuide": true,
  "autoPairBrackets": true,
  "autoPairMarkdown": true,
  "autoConvertHtml": true,
  "foldHeading": true,
  "foldIndent": true,
  "defaultViewMode": "source",
  "livePreview": true,
  "showFrontmatter": false,
  "communityPluginSortOrder": "download",
  "legacyEditor": false,
  "mobileToolbarCommands": [],
  "userIgnoreFilters": [
    "node_modules/",
    ".git/",
    "__pycache__/",
    "tmp/",
    ".kilo/"
  ],
  "corePlugins": {
    "backlink": true,
    "command-palette": true,
    "daily-notes": false,
    "file-explorer": true,
    "file-recovery": true,
    "global-search": true,
    "graph": true,
    "markdown-importer": false,
    "note-composer": true,
    "open-with-default-app": true,
    "outgoing-link": true,
    "outline": true,
    "page-preview": true,
    "properties": false,
    "publish": false,
    "quick-switcher": true,
    "random-note": false,
    "slash-command": false,
    "slides": false,
    "starred": true,
    "switcher": true,
    "sync": false,
    "tag-pane": true,
    "templates": false,
    "unique-note-creator": false,
    "word-count": true,
    "workspaces": false,
    "zk-prefixer": false
  },
  "communityPlugins": [
    "dataview",
    "obsidian-mind-map",
    "tag-wrangler"
  ]
}
